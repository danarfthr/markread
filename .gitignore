# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# agent skills (downloaded tooling, not app code)
# The installed skill bodies are third-party content; skills-lock.json pins
# them and is tracked, so an install is reproducible without vendoring 432K.
/.agents/

# local agent/design docs (kept on disk, not published)
/AGENTS.md
/DESIGN.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
